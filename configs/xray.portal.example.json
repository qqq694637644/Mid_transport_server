{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "mt-vless-reverse",
      "listen": "0.0.0.0",
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "<MT_UUID>",
            "email": "csharp-main",
            "reverse": {
              "tag": "mt-reverse-out"
            }
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none"
      }
    },
    {
      "tag": "mt-public-main",
      "listen": "0.0.0.0",
      "port": 7000,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "mt.reverse.local",
        "port": 1,
        "network": "tcp"
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "mt-public-main"
        ],
        "outboundTag": "mt-reverse-out"
      }
    ]
  },
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
